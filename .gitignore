# ==============================================================================
# RAILNET-AI Master .gitignore
# Problem Statement: SIH26027 · Ministry of Railways
# ==============================================================================

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
*.local
backend/.env
frontend/.env.local
frontend/.env*.local

# --- Node.js & Next.js Build Artifacts ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel/
*.tsbuildinfo
frontend/*.tsbuildinfo

# --- Python & Virtual Environments ---
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
backend/.venv/
venv/
env/
ENV/
.pytest_cache/
backend/.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# --- Database & Local Logs ---
*.sqlite
*.sqlite3
*.db
backend/app.db
backend/data/railradar_cache/_quota_log.json
backend/_quota_log.json
*_quota_log.json

# --- Large Unused Asset Dumps ---
phosphor-icons/

# --- OS & IDE Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
